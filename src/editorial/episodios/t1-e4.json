          "x": 5,
          "y": 5,
          "width": 90,
          "height": 15,
          "description": "PADS entra sola. Ve los brazos reparados y baja las manos.",
          "lines": [
            {
              "kind": "dialogue",
              "speaker": "PADS",
              "text": "Vine a disculparme por lo que hizo SCRATCH."
