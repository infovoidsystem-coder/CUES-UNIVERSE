      "panels": [
        {
          "id": "vineta-1",
          "x": 5,
          "y": 5,
          "width": 90,
          "height": 15,
          "description": "En la base de ECO, CUE pregunta por el ataque.",
          "lines": [
            {
              "kind": "dialogue",
              "speaker": "CUE",
              "text": "¿Por qué estaba tan seguro de que lo traicionaste?"
            }
          ]
        },
        {
          "id": "vineta-2",
          "x": 5,
          "y": 5,
          "width": 90,
          "height": 15,
          "description": "ECO apoya los brazos reparados sobre la mesa.",
          "lines": [
            {
              "kind": "dialogue",
              "speaker": "ECO",
              "text": "Quise protegerlos. Tomé una decisión sin consultar y cargué con las consecuencias."
            }
          ]
        },
        {
          "id": "vineta-3",
          "x": 5,
          "y": 5,
          "width": 90,
          "height": 15,
          "description": "CUE espera el resto. Antes de que ECO vuelva a hablar, alguien golpea la puerta.",
          "lines": [
            {
              "kind": "sfx",
              "text": "TOC, TOC"
            },
            {
              "kind": "dialogue",
              "speaker": "CUE",
              "text": "¿Y SCRATCH sabe lo que me acabás de contar?",
              "estadoEditorial": "pendiente de aprobación"
            }
          ]
        }
      ],
      "audio": []
    },
    {
      "id": "guion-5",
      "image": {
