          "x": 5,
          "y": 5,
          "width": 90,
          "height": 15,
          "description": "Al amanecer, ECO abre los ojos y mira un instante a PLAY antes de comprobar los cables reparados.",
          "lines": [
            {
              "kind": "dialogue",
              "speaker": "ECO",
              "text": "¿Cuánto tiempo me quedé acá?",
