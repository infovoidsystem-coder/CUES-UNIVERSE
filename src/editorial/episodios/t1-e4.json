          "id": "vineta-2",
          "x": 5,
          "y": 5,
          "width": 90,
          "height": 15,
          "description": "CUE se corre para dejarla pasar. PADS toca dos pads en su controlador mientras hablan de música.",
          "lines": [
            {
              "kind": "dialogue",
              "speaker": "PADS",
              "text": "Antes ensayaba con una amiga. Hace mucho que no tocamos juntas."
            }
          ]
        },
        {
          "id": "vineta-3",
          "x": 5,
          "y": 5,
          "width": 90,
          "height": 15,
          "description": "PADS guarda el controlador. ECO observa sus manos cuando ella menciona a SCRATCH.",
          "lines": [
            {
              "kind": "dialogue",
              "speaker": "PADS",
              "text": "Algún día vas a necesitar lo que él sabe del fuego."
            }
          ]
        }
      ],
      "audio": []
    },
